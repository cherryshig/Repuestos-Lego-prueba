<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buscador de Repuestos LEGO</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px; }
    h1 { text-align: center; color: #d32f2f; margin-bottom: 20px; }
    .search-bar { display: flex; gap: 10px; justify-content: center; margin-bottom: 15px; flex-wrap: wrap; }
    input, select { padding: 10px; font-size: 16px; border: 1px solid #ccc; border-radius: 6px; }
    input { width: 300px; max-width: 100%; }
    .filters { text-align: center; margin-bottom: 20px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; }
    .card { background: white; border-radius: 8px; padding: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); text-align: center; }
    .card img { width: 100px; height: 100px; object-fit: contain; margin-bottom: 10px; }
    .card h3 { font-size: 14px; color: #333; }
    .card p { font-size: 12px; color: #777; margin-top: 5px; }
    .card .ref { font-weight: bold; color: #d32f2f; }
    .empty { text-align: center; color: #999; margin-top: 30px; }
  </style>
</head>
<body>
  <h1>🧱 Buscador de Repuestos LEGO</h1>

  <div class="search-bar">
    <input type="text" id="busqueda" placeholder="Busca por nombre o referencia (ej: 3023, rueda, azulejo)">
    <select id="color">
      <option value="">Todos los colores</option>
      <option value="rojo">Rojo</option>
      <option value="azul">Azul</option>
      <option value="amarillo">Amarillo</option>
      <option value="verde">Verde</option>
      <option value="negro">Negro</option>
      <option value="blanco">Blanco</option>
    </select>
  </div>

  <div class="grid" id="grid"></div>
  <div class="empty" id="empty" style="display:none;">No se encontraron piezas 😕</div>

  <script>
    // BASE DE DATOS: agrega aquí tus repuestos
    const piezas = [
      { ref: "3023", nombre: "Placa 1x2", color: "rojo", img: "https://placehold.co/100x100/d32f2f/white?text=3023" },
      { ref: "3001", nombre: "Ladrillo 2x4", color: "azul", img: "https://placehold.co/100x100/1565c0/white?text=3001" },
      { ref: "3065", nombre: "Azulejo 1x2", color: "amarillo", img: "https://placehold.co/100x100/fbc02d/black?text=3065" },
      { ref: "11214", nombre: "Conector con pin", color: "negro", img: "https://placehold.co/100x100/212121/white?text=11214" },
      { ref: "87079", nombre: "Azulejo 2x4", color: "verde", img: "https://placehold.co/100x100/2e7d32/white?text=87079" },
      { ref: "6141", nombre: "Estud (punto) 1x1", color: "blanco", img: "https://placehold.co/100x100/ffffff/black?text=6141" },
      { ref: "30374", nombre: "Varilla 4L", color: "gris", img: "https://placehold.co/100x100/9e9e9e/white?text=30374" }
    ];

    const grid = document.getElementById('grid');
    const empty = document.getElementById('empty');
    const busqueda = document.getElementById('busqueda');
    const colorSel = document.getElementById('color');

    function render() {
      const texto = busqueda.value.toLowerCase().trim();
      const color = colorSel.value;
      const resultados = piezas.filter(p => {
        const coincideTexto = !texto || p.nombre.toLowerCase().includes(texto) || p.ref.includes(texto);
        const coincideColor = !color || p.color === color;
        return coincideTexto && coincideColor;
      });

      grid.innerHTML = '';
      if (resultados.length === 0) {
        empty.style.display = 'block';
        return;
      }
      empty.style.display = 'none';
      resultados.forEach(p => {
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `
          <img src="${p.img}" alt="${p.nombre}">
          <h3>${p.nombre}</h3>
          <p class="ref">Ref: ${p.ref}</p>
          <p>Color: ${p.color}</p>
        `;
        grid.appendChild(card);
      });
    }

    busqueda.addEventListener('input', render);
    colorSel.addEventListener('change', render);
    render();
  </script>
</body>
</html>